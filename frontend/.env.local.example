# frontend/.env.local.example

# ========================
# API
# ========================
# Développement local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production
# NEXT_PUBLIC_API_URL=https://votre-api.railway.app/api/v1

# ========================
# PWA / NOTIFICATIONS
# ========================
# VAPID Public Key (générer avec web-push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre_vapid_public_key

# ========================
# ANALYTICS
# ========================
# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# ========================
# FEATURES
# ========================
# Activer/désactiver certaines fonctionnalités
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PUSH=true
NEXT_PUBLIC_ENABLE_INVOICES=true

# ========================
# IMAGES
# ========================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
