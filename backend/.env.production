# Backend
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vokatra_db
JWT_SECRET_KEY=VOTRE_CLE_SECRETE_TRES_LONGUE_32_CARACTERES_MINIMUM
ENVIRONMENT=production
DEBUG=False

# Cloudinary
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# CORS
CORS_ORIGINS=["https://vokatra.mg","https://www.vokatra.mg"]

# Firebase (optionnel)
FCM_SERVER_KEY=votre_fcm_key
