# Application
APP_NAME=Vokatra API
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Base de données PostgreSQL (asyncpg est ajouté automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/vokatra
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT — clé d'au moins 32 caractères
JWT_SECRET_KEY=change-me-to-a-long-random-string-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase Cloud Messaging (optionnel)
FCM_SERVER_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000", "https://vokatra.mg"]

# Internationalisation
SUPPORTED_LANGUAGES=["fr", "mg"]
DEFAULT_LANGUAGE=fr
