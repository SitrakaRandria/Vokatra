# backend/.env.example

# ========================
# APPLICATION
# ========================
APP_NAME=Vokatra API
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ========================
# BASE DE DONNÉES
# ========================
# Pour le développement local
DATABASE_URL=postgresql+asyncpg://vokatra_user:vokatra_pass@localhost:5432/vokatra_db
# Pour Railway (sera automatiquement injecté)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# Pool de connexions
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ========================
# JWT AUTHENTIFICATION
# ========================
# Générer avec: openssl rand -hex 32
JWT_SECRET_KEY=votre_cle_secrete_32_caracteres_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ========================
# CLOUDINARY
# ========================
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# ========================
# CORS
# ========================
# En développement
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# En production (à décommenter)
# CORS_ORIGINS=["https://vokatra.vercel.app","https://vokatra.mg"]

# ========================
# FIREBASE CLOUD MESSAGING (Notifications)
# ========================
FCM_SERVER_KEY=votre_fcm_server_key
FCM_PROJECT_ID=votre_fcm_project_id
FCM_SENDER_ID=votre_fcm_sender_id

# ========================
# SENTRY (Monitoring)
# ========================
# SENTRY_DSN=https://votre_sentry_dsn

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# ========================
# INTERNATIONALISATION
# ========================
SUPPORTED_LANGUAGES=["fr","mg"]
DEFAULT_LANGUAGE=fr
