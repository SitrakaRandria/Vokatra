# backend/.env.example

# Base de données (sera définie par Railway)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# JWT
JWT_SECRET_KEY=votre_cle_secrete_32_caracteres_minimum

# Cloudinary
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Environment
ENVIRONMENT=production
DEBUG=False

# CORS
CORS_ORIGINS=["https://vokatra.vercel.app","https://vokatra.mg"]

# Firebase (optionnel)
FCM_SERVER_KEY=votre_fcm_key
FCM_PROJECT_ID=votre_project_id
